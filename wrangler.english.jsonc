{
  "name": "educationinasia-en",
  "main": "./workers/educationinasia-en/worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "build": {
    "command": "npm run build"
  }
}
