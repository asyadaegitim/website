{
  "name": "website",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/en",
      "/en/*"
    ]
  },
  "previews": {},
  "main": "./workers/website/worker.js",
  "build": {
    "command": "npm run build"
  },
  "vars": {
    "EN_REDIRECTS_ENABLED": "true"
  }
}
